                            <strong class="d-block text-white fs-6">@v.Marca @v.Modelo</strong>
                            <span class="text-gray text-xs">@(string.IsNullOrEmpty(v.Anio) ? "Año N/A" : v.Anio) • @(string.IsNullOrEmpty(v.Color) ? "Color N/A" : v.Color) • @v.Tipo</span>
