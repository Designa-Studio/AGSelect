            <p class="text-gray text-xs mb-3">Haz clic en uno de tus vehículos guardados para autocompletar este formulario:</p>

            <div class="d-flex flex-column gap-2 mb-3 style-scrollbar" style="max-height: 300px; overflow-y: auto;">
                @foreach (var v in misVehiculosGuardados)
                {
                    <button type="button" class="btn btn-dark text-start p-3 border border-secondary border-opacity-25 hover-border-danger d-flex align-items-center justify-content-between text-white rounded-3" @onclick="() => SeleccionarVehiculoGuardado(v)">
