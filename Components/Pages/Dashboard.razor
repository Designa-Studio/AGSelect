@page "/dashboard"
@layout DashboardLayout
@rendermode InteractiveServer
@using System.Security.Claims
@using BlazorAGS.Models
@using BlazorAGS.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject BookingService BookingService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Dashboard | AGS Select</PageTitle>

<DashSidebar />

<main class="dash-main">

    <!-- TOP BAR -->
    <div class="dash-topbar mb-3">
        <div>
            <h1 class="dash-page-title">Dashboard</h1>
            <span class="text-gray text-xs">Bienvenido de vuelta, <strong class="text-white">@(string.IsNullOrEmpty(nombreUsuario) ? "Usuario" : nombreUsuario)</strong></span>
        </div>
        <a href="/reserva" class="btn-ags-red">
            <i class="fa-solid fa-plus"></i>
            Nueva Reserva
        </a>
    </div>

    <!-- ALERTA CITA APROBADA (ARRIBA DEL TODO) -->
    @if (proximaCitaAprobada != null)
    {
        var pDetalle = proximaCitaAprobada.Detalles.FirstOrDefault();
        var pVeh = pDetalle != null ? $"{pDetalle.Marca} {pDetalle.Modelo}" : "Vehículo";
        var pServ = pDetalle != null ? pDetalle.PaqueteServicio : "Servicio";

        <div class="appt-alert mb-4" style="border-color: #e60000; box-shadow: 0 4px 20px rgba(230,0,0,0.15);">
            <div class="appt-alert-left">
                <div class="appt-alert-icon" style="background: rgba(230,0,0,0.15); color: #e60000;">
                    <i class="fa-solid fa-circle-check fs-4"></i>
                </div>
                <div class="appt-alert-info">
                    <span class="appt-alert-eyebrow text-success fw-bold">
                        <i class="fa-solid fa-square-check me-1"></i> CITA CONFIRMADA / APROBADA
                    </span>
                    <span class="appt-alert-date">
                        @(System.Globalization.CultureInfo.GetCultureInfo("es-ES").TextInfo.ToTitleCase(proximaCitaAprobada.FechaReserva.ToString("dddd, d 'de' MMMM — h:mm tt", new System.Globalization.CultureInfo("es-ES"))))
                    </span>
                    <span class="appt-alert-details">
                        @pVeh &nbsp;·&nbsp; @pServ &nbsp;·&nbsp; <strong style="color:#e60000;">$@proximaCitaAprobada.MontoTotal.ToString("N2") DOP</strong>
                    </span>
                </div>
            </div>
            <button type="button" class="appt-alert-btn" @onclick="PedirConfirmacionReagendar">
                <i class="fa-solid fa-pen-to-square me-1"></i> Reagendar Cita
            </button>
        </div>
    }

    <!-- STAT CARDS (REAL DATA) -->
    <div class="dash-stats-row mb-4">
        <a href="/dashboard/reservas" class="dash-stat-card text-decoration-none" style="cursor: pointer;">
            <div class="dash-stat-icon" style="background:rgba(230,0,0,0.12);color:var(--ags-red);">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
            <div>
                <span class="dash-stat-num">@totalReservas</span>
                <span class="dash-stat-label">Reservas Totales</span>
            </div>
        </a>
        <a href="/dashboard/reservas" class="dash-stat-card text-decoration-none" style="cursor: pointer;">
            <div class="dash-stat-icon" style="background:rgba(34,197,94,0.1);color:#22c55e;">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div>
                <span class="dash-stat-num">@completadas</span>
                <span class="dash-stat-label">Completados</span>
            </div>
        </a>
        <a href="/dashboard/reservas" class="dash-stat-card text-decoration-none" style="cursor: pointer;">
            <div class="dash-stat-icon" style="background:rgba(234,179,8,0.1);color:#eab308;">
                <i class="fa-solid fa-hourglass-half"></i>
            </div>
            <div>
                <span class="dash-stat-num">@pendientes</span>
                <span class="dash-stat-label">Pendiente</span>
            </div>
        </a>
        <a href="/dashboard/vehiculos" class="dash-stat-card text-decoration-none" style="cursor: pointer;">
            <div class="dash-stat-icon" style="background:rgba(99,102,241,0.1);color:#818cf8;">
                <i class="fa-solid fa-car"></i>
            </div>
            <div>
                <span class="dash-stat-num">@totalVehiculos</span>
                <span class="dash-stat-label">Vehículos</span>
            </div>
        </a>
    </div>

    <!-- MAIN CONTENT GRID -->
    <div class="row g-4">

        <!-- COLUMNA IZQUIERDA: RESERVAS RECIENTES -->
        <div class="col-lg-7">
            <div class="dash-card mb-4">
                <div class="dash-card-header">
                    <h2 class="dash-card-title">Reservas Recientes</h2>
                    <a href="/dashboard/reservas" class="btn-link-subtle">Ver todas</a>
                </div>
                <div class="dash-table-wrap overflow-hidden">
                    @if (cargando)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-danger" role="status"></div>
                        </div>
                    }
                    else if (!reservasRecientes.Any())
                    {
                        <div class="text-center py-4">
                            <i class="fa-solid fa-calendar-xmark text-gray display-6 mb-2 opacity-50"></i>
                            <p class="text-gray text-xs mb-0">No tienes reservas registradas aún.</p>
                        </div>
                    }
                    else
                    {
                        <table class="dash-table table-borderless text-white mb-0" style="width: 100%; layout: fixed;">
                            <thead>
                                <tr class="text-gray text-xs" style="border-bottom: 1px solid #171a24;">
                                    <th style="padding: 10px 8px;">Vehículo</th>
                                    <th style="padding: 10px 8px;">Servicio</th>
                                    <th style="padding: 10px 8px;">Fecha</th>
                                    <th style="padding: 10px 8px;">Monto</th>
                                    <th style="padding: 10px 8px;">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in reservasRecientes.Take(4))
                                {
                                    var primerDetalle = r.Detalles.FirstOrDefault();
                                    var vehNombre = primerDetalle != null ? $"{primerDetalle.Marca} {primerDetalle.Modelo}".Trim() : "Vehículo";
                                    var servicioNombre = primerDetalle != null ? primerDetalle.PaqueteServicio : "Tratamiento";

                                    <tr style="border-bottom: 1px solid #171a24; background: transparent;">
                                        <td class="py-3 px-2 align-middle">
                                            <div class="dash-vehicle-cell text-truncate" style="max-width: 130px;">
                                                <i class="fa-solid fa-car text-red me-1"></i>
                                                <span class="text-white text-xs fw-bold">@vehNombre</span>
                                            </div>
                                        </td>
                                        <td class="py-3 px-2 align-middle text-gray text-xs text-truncate" style="max-width: 140px;">@servicioNombre</td>
                                        <td class="py-3 px-2 align-middle text-white text-xs">@r.FechaReserva.ToString("dd MMM yyyy")</td>
                                        <td class="py-3 px-2 align-middle text-white fw-bold text-xs">$@r.MontoTotal.ToString("N0") DOP</td>
                                        <td class="py-3 px-2 align-middle">
                                            <span class="dash-badge @GetBadgeClass(r.Estado)" style="font-size: 0.7rem; padding: 2px 6px;">@r.Estado</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <!-- COLUMNA DERECHA: ESTADO DE MEMBRESÍA VIP -->
        <div class="col-lg-5">
            <div class="dash-card mb-4" style="background: #0b0c10; border: 1px solid #171a24; border-radius: 14px; padding: 24px;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="dash-card-title text-white fw-bold mb-0 fs-5">Membresía VIP</h2>
                    <span class="dash-badge badge-done">
                        <i class="fa-solid fa-crown me-1"></i> Activa
                    </span>
                </div>
                <p class="text-gray text-xs mb-4">Tienes acceso exclusivo a beneficios Fast-Track, lavados de regalo y atención prioritaria en taller.</p>
                
                <a href="/dashboard/membresia" class="btn btn-ags-red w-100 py-2 fw-bold text-white d-flex align-items-center justify-content-center gap-2" style="border-radius: 8px;">
                    <i class="fa-solid fa-qrcode"></i> Ver Mi Tarjeta Digital
                </a>
            </div>
        </div>

    </div>

</main>

<!-- MODAL REAGENDAR (STRICT OVERLAY - NO CIERRA AL HACER CLICK FUERA) -->
@if (modalReagendarVisible)
{
    <div class="auth-overlay" style="background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 9999;">
        <div class="auth-modal p-4 text-white" style="max-width: 520px; width: 92%; background: #0e1017; border: 1px solid #232838; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.8);">
            
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-calendar-pen text-warning fs-4"></i>
                    <h5 class="text-white fw-bold mb-0">Reagendar Cita Aprobada</h5>
                </div>
                <button type="button" class="btn-close btn-close-white text-xs opacity-75" @onclick="CerrarModalReagendar"></button>
            </div>

            <!-- ADVERTENCIA DE CAMBIO DE ESTADO -->
            <div class="p-3 bg-warning bg-opacity-10 rounded-3 border border-warning border-opacity-25 mb-4">
                <div class="d-flex gap-2">
                    <i class="fa-solid fa-triangle-exclamation text-warning fs-5 flex-shrink-0 mt-1"></i>
                    <div class="text-xs">
                        <span class="text-warning fw-bold d-block mb-1">¡Atención! La cita volverá a estar PENDIENTE</span>
                        <span class="text-gray">Al cambiar la fecha u hora, la reserva requerirá nuevamente de la aprobación del dueño/administrador de AGS Select.</span>
                    </div>
                </div>
            </div>

            <!-- FORMULARIO DE SELECCIÓN DE NUEVA FECHA Y HORA -->
            <div class="mb-3">
                <label class="form-label text-xs text-gray fw-bold text-uppercase">1. Nueva Fecha de Servicio</label>
                <input type="date" class="form-control text-white border-secondary bg-dark text-sm py-2"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       value="@nuevaFecha.ToString("yyyy-MM-dd")"
                       @onchange="OnNuevaFechaChanged" style="color-scheme: dark;" />
            </div>

            <div class="mb-4">
                <label class="form-label text-xs text-gray fw-bold text-uppercase mb-2">2. Nueva Hora de Servicio</label>
                <div class="row g-2">
                    @foreach (var slot in franjasHorarias)
                    {
                        var ocupado = EsHoraOcupada(slot);
                        var seleccionada = slot == nuevaHora;

                        <div class="col-4">
                            <button type="button"
                                    class="btn w-100 text-xs py-2 fw-bold rounded-2 transition-all @(seleccionada ? "btn-danger" : (ocupado ? "btn-dark border-secondary text-muted opacity-50 disabled" : "btn-dark border-secondary text-white"))"
                                    disabled="@ocupado"
                                    @onclick="() => SeleccionarHora(slot)">
                                <i class="fa-regular fa-clock me-1"></i>@slot
                                @if (ocupado)
                                {
                                    <span class="d-block text-danger" style="font-size: 0.65rem;">(Ocupado)</span>
                                }
                            </button>
                        </div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(mensajeErrorReagendar))
            {
                <div class="alert alert-danger text-xs py-2 mb-3">
                    <i class="fa-solid fa-circle-exclamation me-1"></i>@mensajeErrorReagendar
                </div>
            }

            <div class="d-flex gap-2 justify-content-end pt-2 border-top border-secondary border-opacity-25">
                <button type="button" class="btn btn-outline-secondary text-white px-4 py-2 text-xs rounded-3" @onclick="CerrarModalReagendar" disabled="@guardandoReagendar">
                    Cancelar
                </button>
                <button type="button" class="btn btn-warning px-4 py-2 text-xs fw-bold rounded-3 text-dark" @onclick="GuardarNuevoReagendamiento" disabled="@guardandoReagendar">
                    @if (guardandoReagendar)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-check me-1"></i>
                        <span>Confirmar Reagendamiento</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int? usuarioId = null;
    private string nombreUsuario = "";
    private bool cargando = true;

    // MODAL REAGENDAR STATE
    private bool modalReagendarVisible = false;
    private bool guardandoReagendar = false;
    private string mensajeErrorReagendar = "";
    private DateTime nuevaFecha = DateTime.Today.AddDays(1);
    private string nuevaHora = "09:00 AM";

    private List<DateTime> reservasOcupadasFechasHoras = new();
    private readonly List<string> franjasHorarias = new()
    {
        "08:00 AM", "09:30 AM", "11:00 AM", "01:30 PM", "03:00 PM", "04:30 PM"
    };

    private int totalReservas = 0;
    private int completadas = 0;
    private int pendientes = 0;
    private int totalVehiculos = 0;

    private List<ReservaDto> reservasRecientes = new();
    private ReservaDto? proximaCitaAprobada = null;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;
            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var idClaim = user.FindFirst(ClaimTypes.NameIdentifier);
                if (idClaim != null && int.TryParse(idClaim.Value, out int id))
                {
                    usuarioId = id;
                    var dbUser = await AuthService.ObtenerUsuarioPorIdAsync(id);
                    if (dbUser != null)
                    {
                        nombreUsuario = dbUser.Nombre;
                    }
                    else
                    {
                        nombreUsuario = user.Identity.Name ?? "";
                    }

                    await CargarDatosDashboard();
                }
            }
        }
        cargando = false;
    }

    private async Task CargarDatosDashboard()
    {
        if (usuarioId.HasValue)
        {
            var reservas = await BookingService.ObtenerReservasPorUsuarioAsync(usuarioId.Value);
            totalReservas = reservas.Count;
            completadas = reservas.Count(r => r.Estado.Equals("Completada", StringComparison.OrdinalIgnoreCase) || r.Estado.Equals("Completado", StringComparison.OrdinalIgnoreCase) || r.Estado.Equals("Aprobada", StringComparison.OrdinalIgnoreCase) || r.Estado.Equals("Aprobado", StringComparison.OrdinalIgnoreCase));
            pendientes = reservas.Count(r => r.Estado.Equals("Pendiente", StringComparison.OrdinalIgnoreCase));

            reservasRecientes = reservas;

            // Próxima cita SOLO APROBADA/CONFIRMADA (y futura)
            proximaCitaAprobada = reservas
                .Where(r => r.FechaReserva >= DateTime.Today && 
                           (r.Estado.Equals("Aprobada", StringComparison.OrdinalIgnoreCase) || 
                            r.Estado.Equals("Aprobado", StringComparison.OrdinalIgnoreCase) || 
                            r.Estado.Equals("Confirmada", StringComparison.OrdinalIgnoreCase) || 
                            r.Estado.Equals("Confirmado", StringComparison.OrdinalIgnoreCase)))
                .OrderBy(r => r.FechaReserva)
                .FirstOrDefault();

            var vehiculos = await BookingService.ObtenerVehiculosPorUsuarioAsync(usuarioId.Value);
            totalVehiculos = vehiculos.Count;
        }
    }

    private async Task PedirConfirmacionReagendar()
    {
        mensajeErrorReagendar = "";
        reservasOcupadasFechasHoras = await BookingService.ObtenerFechasHorasReservadasAsync();
        if (proximaCitaAprobada != null)
        {
            nuevaFecha = proximaCitaAprobada.FechaReserva.Date;
            nuevaHora = proximaCitaAprobada.FechaReserva.ToString("hh:mm tt").ToUpper();
        }
        else
        {
            nuevaFecha = DateTime.Today.AddDays(1);
            nuevaHora = "09:00 AM";
        }
        modalReagendarVisible = true;
    }

    private void CerrarModalReagendar()
    {
        modalReagendarVisible = false;
    }

    private void OnNuevaFechaChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            nuevaFecha = dt;
        }
    }

    private void SeleccionarHora(string slot)
    {
        nuevaHora = slot;
    }

    private bool EsHoraOcupada(string slot)
    {
        if (!DateTime.TryParse($"{nuevaFecha:yyyy-MM-dd} {slot}", out var slotDateTime))
            return false;

        // Si es la misma reserva actual que estamos reagendando, no marcar como ocupada
        if (proximaCitaAprobada != null && Math.Abs((proximaCitaAprobada.FechaReserva - slotDateTime).TotalMinutes) < 15)
            return false;

        return reservasOcupadasFechasHoras.Any(dt => Math.Abs((dt - slotDateTime).TotalMinutes) < 15);
    }

    private async Task GuardarNuevoReagendamiento()
    {
        if (proximaCitaAprobada == null) return;

        if (!DateTime.TryParse($"{nuevaFecha:yyyy-MM-dd} {nuevaHora}", out var nuevaFechaHoraCompleta))
        {
            mensajeErrorReagendar = "Selecciona una fecha y hora válidas.";
            return;
        }

        if (nuevaFechaHoraCompleta < DateTime.Now)
        {
            mensajeErrorReagendar = "No puedes seleccionar una fecha u hora en el pasado.";
            return;
        }

        guardandoReagendar = true;
        bool ok = await BookingService.ReagendarReservaAsync(proximaCitaAprobada.Id, nuevaFechaHoraCompleta);
        guardandoReagendar = false;

        if (ok)
        {
            modalReagendarVisible = false;
            await CargarDatosDashboard();
        }
        else
        {
            mensajeErrorReagendar = "Ocurrió un error al actualizar la reserva. Intenta nuevamente.";
        }
    }

    private string GetBadgeClass(string estado) => estado?.ToLower() switch
    {
        "pendiente" => "badge-pending",
        "completada" or "completado" or "aprobada" or "aprobado" or "confirmada" => "badge-done",
        "cancelada" or "cancelado" => "badge-cancel",
        _ => "badge-pending"
    };
}
