        </div>
    </div>
}

@code {
    private int pasoActual = 1;
    private int vehiculoActivoIdx = 0;

    private string clienteNombre = "";
    private string clienteCorreo = "";
    private string clienteTelefono = "";
    private DateTime fechaReserva = DateTime.Now.AddDays(1);
    private DateTime fechaSeleccionada = DateTime.Today.AddDays(1);
    private string horaSeleccionada = "09:30 AM";
    private int calMes = DateTime.Today.Month;
    private int calAnio = DateTime.Today.Year;
    private string opcionEntrega = "Taller";
    private bool reservaConfirmada = false;
    private bool cargandoServicios = true;
    private string? mensajeError = null;

    private bool intentoEnviarPaso1 = false;
    private bool intentoEnviarPaso2 = false;
    private bool intentoEnviarPaso3 = false;

    private List<string> horariosDisponibles = new()
    {
        "08:00 AM",
        "09:30 AM",
        "11:00 AM",
        "01:30 PM",
        "03:00 PM",
        "04:30 PM"
    };

    public class VehiculoModel
    {
        public string Tipo { get; set; } = "Car";
        public string Marca { get; set; } = "";
        public string Modelo { get; set; } = "";
        public string Anio { get; set; } = "";
        public string Color { get; set; } = "";
        public ServiceGroup? GrupoSeleccionado { get; set; }
        public List<AdditionalService> AdicionalesSeleccionados { get; set; } = new();

        public bool EsValido()
        {
            return !string.IsNullOrWhiteSpace(Tipo) &&
                   !string.IsNullOrWhiteSpace(Marca) &&
                   !string.IsNullOrWhiteSpace(Modelo);
        }

        public decimal Subtotal
        {
            get
            {
                decimal total = 0;
                if (GrupoSeleccionado != null)
                {
                    total += GrupoSeleccionado.GetPriceForVehicleType(Tipo);
                }
                foreach (var add in AdicionalesSeleccionados)
                {
                    total += add.GetPriceForVehicleType(Tipo);
                }
                return total;
            }
        }
    }

    private List<VehiculoModel> vehiculos = new() { new VehiculoModel() };
    private List<ServiceGroup> gruposServicios = new();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int? usuarioId = null;

    private List<DateTime> fechasHorasReservadas = new();

    private List<VehiculoDto> misVehiculosGuardados = new();
    private bool modalCargarVehiculoVisible = false;
    private int vehiculoIndiceAAutoLlenar = 0;

    private List<CategoriaVehiculoDto> listaCategorias = new();
    private List<OpcionEntregaDto> listaOpcionesEntrega = new();

    private bool tieneLavadoGratis = false;

    protected override async Task OnInitializedAsync()
    {
        cargandoServicios = true;
        try
        {
            gruposServicios = await BookingService.GetActiveServiceGroupsAsync();
            fechasHorasReservadas = await BookingService.ObtenerFechasHorasReservadasAsync();
            bloqueosCalendario = await BookingService.ObtenerBloqueosCalendarioAsync();
            listaCategorias = await BookingService.ObtenerCategoriasVehiculoAsync();
            listaOpcionesEntrega = await BookingService.ObtenerOpcionesEntregaAsync();
        }
        finally
        {
            cargandoServicios = false;
        }

        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;
            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var idClaim = user.FindFirst(ClaimTypes.NameIdentifier);
                if (idClaim != null && int.TryParse(idClaim.Value, out int id))
                {
                    usuarioId = id;
                    var dbUser = await AuthService.ObtenerUsuarioPorIdAsync(id);
                    if (dbUser != null)
                    {
                        clienteNombre = dbUser.Nombre;
                        clienteCorreo = dbUser.Correo;
                        clienteTelefono = dbUser.Telefono ?? "";
                        tieneLavadoGratis = dbUser.LavadosCompletados >= 7;
                    }
                    else
                    {
                        clienteNombre = user.Identity.Name ?? "";
                        clienteCorreo = user.FindFirst(ClaimTypes.Email)?.Value ?? "";
                    }

                    misVehiculosGuardados = await BookingService.ObtenerVehiculosPorUsuarioAsync(id);
                }
            }
        }

        // Asegurar que la fecha inicial seleccionada no esté completamente llena o en el pasado
        AsegurarFechaValidaInicial();
    }

    private void AbrirModalCargarVehiculo(int index)
    {
        vehiculoIndiceAAutoLlenar = index;
        modalCargarVehiculoVisible = true;
    }

    private void CerrarModalCargarVehiculo()
    {
        modalCargarVehiculoVisible = false;
    }

    private void SeleccionarVehiculoGuardado(VehiculoDto veh)
    {
        if (vehiculoIndiceAAutoLlenar >= 0 && vehiculoIndiceAAutoLlenar < vehiculos.Count)
        {
            var vForm = vehiculos[vehiculoIndiceAAutoLlenar];
            vForm.Tipo = veh.Tipo;
            vForm.Marca = veh.Marca;
            vForm.Modelo = veh.Modelo;
            vForm.Anio = veh.Anio ?? "";
            vForm.Color = veh.Color ?? "";
        }
        modalCargarVehiculoVisible = false;
    }

    private void AsegurarFechaValidaInicial()
    {
        while (EsDiaTotalmenteBloqueado(fechaSeleccionada) || fechaSeleccionada.Date < DateTime.Today)
        {
            fechaSeleccionada = fechaSeleccionada.AddDays(1);
        }
        AsegurarHoraValidaParaFecha(fechaSeleccionada);
    }

    private bool EsHoraBloqueada(DateTime fecha, string horaStr)
    {
        if (fecha.Date < DateTime.Today) return true;

        if (DateTime.TryParse(horaStr, out var parsedTime))
        {
            var dtSlot = fecha.Date + parsedTime.TimeOfDay;
            
            // Si es hoy y la hora ya pasó
            if (fecha.Date == DateTime.Today && dtSlot <= DateTime.Now) return true;

            // Verificar si ya existe una reserva activa para esa fecha y hora exacta
            return fechasHorasReservadas.Any(r => r.Date == fecha.Date && r.Hour == dtSlot.Hour && r.Minute == dtSlot.Minute);
        }
        return false;
    }

    private List<BloqueoCalendarioDto> bloqueosCalendario = new();

    private bool EsDiaTotalmenteBloqueado(DateTime fecha)
    {
        if (fecha.Date < DateTime.Today) return true;

        // Verificar si la fecha está bloqueada explícitamente en el módulo de administración
        if (bloqueosCalendario.Any(b => !b.EsRecurrente && b.FechaBloqueada.HasValue && b.FechaBloqueada.Value.Date == fecha.Date))
            return true;

        // Verificar si el día de la semana está bloqueado de forma recurrente (ej: Domingo = 0)
        int diaSemana = (int)fecha.DayOfWeek;
        if (bloqueosCalendario.Any(b => b.EsRecurrente && b.DiaSemana.HasValue && b.DiaSemana.Value == diaSemana))
            return true;

        // Un día está totalmente bloqueado solo si TODAS las horas disponibles están bloqueadas
        return horariosDisponibles.All(hora => EsHoraBloqueada(fecha, hora));
    }

    private void AsegurarHoraValidaParaFecha(DateTime fecha)
    {
        var disponible = horariosDisponibles.FirstOrDefault(h => !EsHoraBloqueada(fecha, h));
        if (disponible != null)
        {
            horaSeleccionada = disponible;
            ActualizarFechaReserva();
        }
    }

    private void IrAlPasoDirecto(int paso)
    {
        mensajeError = null;
        if (paso > 1 && !ValidarPaso1())
        {
            intentoEnviarPaso1 = true;
            mensajeError = "Por favor completa la información de Marca y Modelo de cada vehículo antes de avanzar.";
            return;
        }
        if (paso > 2 && !ValidarPaso2())
        {
            intentoEnviarPaso2 = true;
            mensajeError = "Por favor selecciona un paquete de tratamiento para todos los vehículos registrados.";
            return;
        }

        IrAlPaso(paso);
    }

    private void IrAlPaso(int paso)
    {
        mensajeError = null;
        pasoActual = paso;
        if (pasoActual == 2)
        {
            vehiculoActivoIdx = 0;
        }
    }

    private bool ValidarPaso1()
    {
        return vehiculos.All(v => v.EsValido());
    }

    private void ValidarYContinuarPaso1()
    {
        intentoEnviarPaso1 = true;
        if (!ValidarPaso1())
        {
            mensajeError = "Por favor completa la información obligatoria (Marca y Modelo) de todos los vehículos.";
            return;
        }

        mensajeError = null;
        IrAlPaso(2);
    }

    private bool ValidarPaso2()
    {
        return vehiculos.All(v => v.GrupoSeleccionado != null);
    }

    private void SiguienteVehiculoOPaso()
    {
        var vehiculoActual = vehiculos[Math.Min(vehiculoActivoIdx, vehiculos.Count - 1)];
        if (vehiculoActual.GrupoSeleccionado == null)
        {
            intentoEnviarPaso2 = true;
            mensajeError = $"Por favor selecciona un paquete de tratamiento para el Vehículo {vehiculoActivoIdx + 1}.";
            return;
        }

        mensajeError = null;
        CambiarVehiculoActivo(vehiculoActivoIdx + 1);
    }

    private void ValidarYContinuarPaso2()
    {
        intentoEnviarPaso2 = true;
        if (!ValidarPaso2())
        {
            var vehiculoIncompletoIdx = vehiculos.FindIndex(v => v.GrupoSeleccionado == null);
            if (vehiculoIncompletoIdx >= 0)
            {
                vehiculoActivoIdx = vehiculoIncompletoIdx;
            }
            mensajeError = "Debes seleccionar un paquete de tratamiento para todos los vehículos antes de continuar.";
            return;
        }

        mensajeError = null;
        IrAlPaso(3);
    }

    private bool EsCorreoValido(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;
        return email.Contains("@") && email.Contains(".");
    }

    private bool ValidarPaso3()
    {
        return !string.IsNullOrWhiteSpace(clienteNombre) &&
               EsCorreoValido(clienteCorreo) &&
               !string.IsNullOrWhiteSpace(clienteTelefono) &&
               fechaReserva > DateTime.Now;
    }

    private void CambiarVehiculoActivo(int index)
    {
        if (index >= 0 && index < vehiculos.Count)
        {
            vehiculoActivoIdx = index;
        }
    }

    private void AgregarVehiculo()
    {
        if (vehiculos.Count < 5)
        {
            vehiculos.Add(new VehiculoModel());
        }
    }

    private void RemoverVehiculo(int index)
    {
        if (vehiculos.Count > 1 && index >= 0 && index < vehiculos.Count)
        {
            vehiculos.RemoveAt(index);
            if (vehiculoActivoIdx >= vehiculos.Count)
            {
                vehiculoActivoIdx = vehiculos.Count - 1;
            }
        }
    }

    private void SeleccionarGrupo(VehiculoModel vehiculo, ServiceGroup grupo)
    {
        vehiculo.GrupoSeleccionado = grupo;
        vehiculo.AdicionalesSeleccionados.Clear();
        mensajeError = null;
    }

    private void ToggleAdicional(VehiculoModel vehiculo, AdditionalService adicional)
    {
        var existente = vehiculo.AdicionalesSeleccionados.FirstOrDefault(a => a.Id == adicional.Id);
        if (existente != null)
        {
            vehiculo.AdicionalesSeleccionados.Remove(existente);
        }
        else
        {
            vehiculo.AdicionalesSeleccionados.Add(adicional);
        }
    }

    private decimal ObtenerCostoEntrega()
    {
        var opt = listaOpcionesEntrega.FirstOrDefault(o => o.Nombre.Equals(opcionEntrega, StringComparison.OrdinalIgnoreCase));
        if (opt != null) return opt.CostoAdicional;

        // Fallback para hardcoded pickup
        if (opcionEntrega.Equals("PickUp", StringComparison.OrdinalIgnoreCase)) return 500;
        return 0;
    }

    private decimal CalcularTotalSinDescuento()
    {
        return vehiculos.Sum(v => v.Subtotal) + ObtenerCostoEntrega();
    }

    private decimal CalcularTotal()
    {
        if (usuarioId.HasValue && tieneLavadoGratis)
        {
            return 0;
        }
        return CalcularTotalSinDescuento();
    }

    private void MesAnterior()
    {
        if (calMes == 1) { calMes = 12; calAnio--; }
        else calMes--;
    }

    private void MesSiguiente()
    {
        if (calMes == 12) { calMes = 1; calAnio++; }
        else calMes++;
    }

    private void SeleccionarFecha(DateTime fecha)
    {
        if (EsDiaTotalmenteBloqueado(fecha)) return;
        fechaSeleccionada = fecha;

        if (EsHoraBloqueada(fechaSeleccionada, horaSeleccionada))
        {
            AsegurarHoraValidaParaFecha(fechaSeleccionada);
        }
        else
        {
            ActualizarFechaReserva();
        }
    }

    private void SeleccionarHora(string hora)
    {
        horaSeleccionada = hora;
        ActualizarFechaReserva();
    }

    private void OnFechaCustomChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            fechaSeleccionada = dt;
            ActualizarFechaReserva();
        }
    }

    private void ActualizarFechaReserva()
    {
        try
        {
            var timeSpan = TimeSpan.FromHours(9);
            if (DateTime.TryParse(horaSeleccionada, out var parsedTime))
            {
                timeSpan = parsedTime.TimeOfDay;
            }
            fechaReserva = fechaSeleccionada.Date + timeSpan;
        }
        catch
        {
            fechaReserva = fechaSeleccionada;
        }
    }

    private bool guardandoReserva = false;

    private async Task ConfirmarReserva()
    {
        ActualizarFechaReserva();
        intentoEnviarPaso3 = true;
        if (!ValidarPaso3())
        {
            mensajeError = "Por favor completa todos los campos de contacto con datos válidos y selecciona una fecha futura.";
            return;
        }

        mensajeError = null;
        guardandoReserva = true;
        StateHasChanged();

        // Breve retraso visual para la animación de Carga (Loading Overlay)
        await Task.Delay(1200);

        var dto = new ReservaDto
        {
            UsuarioId = usuarioId,
            ClienteNombre = clienteNombre,
            ClienteCorreo = clienteCorreo,
            ClienteTelefono = clienteTelefono,
            FechaReserva = fechaReserva,
            OpcionEntrega = opcionEntrega,
            MontoTotal = CalcularTotal(),
            EsLavadoGratis = usuarioId.HasValue && tieneLavadoGratis,
            Estado = "Pendiente",
            Detalles = vehiculos.Select(v => new ReservaDetalleDto
            {
                TipoVehiculo = v.Tipo,
                Marca = v.Marca,
                Modelo = v.Modelo,
                Anio = v.Anio,
                Color = v.Color,
                PaqueteServicio = v.GrupoSeleccionado != null 
                    ? v.GrupoSeleccionado.Name 
                    : "Servicio Estándar",
                Precio = (usuarioId.HasValue && tieneLavadoGratis) ? 0 : v.Subtotal
            }).ToList()
        };

        int idGenerado = await BookingService.CrearReservaAsync(dto);
        guardandoReserva = false;

        if (idGenerado > 0)
        {
            reservaConfirmada = true;
        }
        else
        {
            mensajeError = "Ocurrió un error al procesar tu reserva en la base de datos. Inténtalo de nuevo.";
        }

        StateHasChanged();
    }

    private void NuevaReserva()
    {
        vehiculos = new() { new VehiculoModel() };
        clienteNombre = "";
        clienteCorreo = "";
        clienteTelefono = "";
        fechaSeleccionada = DateTime.Today.AddDays(1);
        horaSeleccionada = "09:30 AM";
        ActualizarFechaReserva();
        pasoActual = 1;
        vehiculoActivoIdx = 0;
        reservaConfirmada = false;
        intentoEnviarPaso1 = false;
        intentoEnviarPaso2 = false;
        intentoEnviarPaso3 = false;
        mensajeError = null;
    }
}
